# Digitaly production environment. Copy to .env.production and fill in real values:
#   cp .env.production.example .env.production
# Never commit .env.production. Generate random values with:
#   openssl rand -hex 32
# Run Compose with: docker compose --env-file .env.production -f docker-compose.prod.yml ...

# --- Edge / TLS -------------------------------------------------------------
# Public FQDN with an A/AAAA record pointing at the VPS.
DOMAIN=digitaly.example.com
# Contact address for Let's Encrypt expiry notices.
ACME_EMAIL=ops@example.com
# Public IP of the VPS. Used by the bundled coturn TURN server to advertise the
# correct address when the host is behind 1:1 NAT (most cloud VMs).
PUBLIC_IP=203.0.113.10
# The host's primary interface IP that coturn binds relays to. On a NAT'd cloud
# VM this is the private address (`ip -4 addr show`); on a host with the public
# IP directly, set it to PUBLIC_IP.
TURN_LOCAL_IP=10.0.0.10

# --- PostgreSQL -------------------------------------------------------------
POSTGRES_USER=digitaly
POSTGRES_PASSWORD=CHANGE_ME__openssl_rand_hex_32
POSTGRES_DB=digitaly
# Used by tooling outside Compose. Compose rebuilds the API URL from POSTGRES_*,
# so keep user/password/db consistent. Use hex passwords to avoid URL escaping.
DATABASE_URL=postgresql://digitaly:CHANGE_ME__openssl_rand_hex_32@db:5432/digitaly

# --- Web (inlined into the bundle at build time) ----------------------------
NEXT_PUBLIC_API_URL=https://digitaly.example.com/api
NEXT_PUBLIC_SOCKET_URL=https://digitaly.example.com
# Demo-only MailHog inbox link, served at mail.$DOMAIN behind basic auth.
# Set to https://mail.<your-domain> when the MailHog service is enabled.
NEXT_PUBLIC_MAILHOG_URL=https://mail.digitaly.example.com

# --- API --------------------------------------------------------------------
NODE_ENV=production
PORT=3001
JWT_SECRET=CHANGE_ME__openssl_rand_hex_32
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
OTP_PEPPER=CHANGE_ME__openssl_rand_hex_32
OTP_TTL_SECONDS=600
OTP_MAX_ATTEMPTS=5
# Keep false in production; doctors are onboarded manually / via seed.
ALLOW_DOCTOR_SELF_REGISTRATION=false
# Keep false so the OpenAPI schema and /docs are not exposed.
SWAGGER_ENABLED=false
# Comma-separated CORS allow-list. Must include the public origin.
WEB_ORIGIN=https://digitaly.example.com
AI_SERVICE_URL=http://ai:8000
AI_BASE_URL=http://ai:8000
AI_WS_URL=ws://ai:8000
# Shared service-to-service token; must be identical for api and ai.
AI_INTERNAL_TOKEN=CHANGE_ME__openssl_rand_hex_32
UPLOAD_DIR=/app/uploads
UPLOAD_MAX_BYTES=10485760
# local today; S3-compatible object storage is the production target.
STORAGE_DRIVER=local
# --- WebRTC TURN (bundled coturn) -------------------------------------------
# STUN alone fails on restrictive networks. coturn is included in the prod stack
# and listens on 3478/tcp+udp and relay ports 49160-49200/udp (open them in the
# firewall). Clients receive these URLs plus the credentials via the API.
STUN_URLS=stun:stun.l.google.com:19302
TURN_URLS=turn:203.0.113.10:3478?transport=udp,turn:203.0.113.10:3478?transport=tcp
TURN_USERNAME=digitaly
TURN_CREDENTIAL=CHANGE_ME__openssl_rand_hex_16

# --- Mail -------------------------------------------------------------------
# MailHog is included in docker-compose.prod.yml for the demo (api -> mailhog:1025,
# UI at mail.$DOMAIN). For real delivery (production), switch these to a provider
# such as Brevo/Resend/SendGrid and remove or keep the mailhog service internal.
MAIL_HOST=mailhog
MAIL_PORT=1025
MAIL_USER=
MAIL_PASSWORD=
MAIL_FROM=no-reply@digitaly.health

# --- Demo seed (explicit `seed` profile only) -------------------------------
# Password for the fictional demo accounts created by `prisma db seed`. It is
# required to run the seed profile and has no production default. Generate one:
#   openssl rand -base64 24
# Never reuse the local-dev fallback Demo@1234 on a host reachable from the
# Internet; see the access-control section below.
SEED_DEMO_PASSWORD=CHANGE_ME__demo_seed_password

# --- Demo access control (required while MailHog/seed are enabled) -----------
# The seeded demo (fictional patients + a MailHog inbox full of codes) must not
# be public. Basic auth protects the web UI and the MailHog inbox only; /api and
# /socket.io keep the app's JWT auth, because basic auth would consume the
# Authorization header. Required by Compose. Generate the hash with:
#   docker run --rm caddy:2-alpine caddy hash-password --plaintext 'YOUR_PASSWORD'
DEMO_BASIC_AUTH_USER=digitaly
DEMO_BASIC_AUTH_HASH=CHANGE_ME__caddy_hash_password

# --- AI copilot -------------------------------------------------------------
# fake | local | openai. `fake` is the safe demo default and calls no external
# processor. `openai` sends consultation audio/transcripts to a third party and
# requires a documented legal basis plus a signed DPA (LGPD); keep it off until
# both are in place.
AI_PROVIDER=fake
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini
STT_MODEL=whisper-1
LLM_TIMEOUT_SECONDS=30
WHISPER_MODEL=base
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8
SESSION_TTL_SECONDS=900
MAX_BUFFER_BYTES=1920000
PARTIAL_INTERVAL_SECONDS=2.5
LOG_LEVEL=INFO

# --- Optional overrides -----------------------------------------------------
# Seconds the API entrypoint waits for Postgres before failing.
# DB_WAIT_TIMEOUT=60
