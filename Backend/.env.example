NODE_ENV=development
PORT=3001
DATABASE_URL=postgresql://postgres:postgres@localhost:5433/digitaly_tmp
WEB_ORIGIN=http://localhost:3000
JWT_SECRET=replace-with-a-random-secret
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=replace-with-another-random-secret
JWT_REFRESH_EXPIRES_IN=7d
MAIL_HOST=localhost
MAIL_PORT=1025
MAIL_USER=
MAIL_PASSWORD=
MAIL_FROM=no-reply@digitaly.health
OTP_PEPPER=replace-with-a-random-pepper
OTP_TTL_SECONDS=600
OTP_MAX_ATTEMPTS=5
AI_SERVICE_URL=http://localhost:8000
AI_BASE_URL=
AI_WS_URL=
AI_INTERNAL_TOKEN=replace-with-a-random-internal-token
# Storage of uploaded consultation attachments. Files are never served statically.
UPLOAD_DIR=./uploads
UPLOAD_MAX_BYTES=10485760
STORAGE_DRIVER=local
STUN_URLS=stun:stun.l.google.com:19302
TURN_URLS=
TURN_USERNAME=
TURN_CREDENTIAL=
