{
	email {$ACME_EMAIL}
	admin off
}

# Apex site. Automatic HTTPS is issued for {$DOMAIN}.
{$DOMAIN} {
	encode zstd gzip

	log {
		output stdout
		format json
	}

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		X-Frame-Options "DENY"
		Permissions-Policy "camera=(self), microphone=(self), geolocation=()"
		Content-Security-Policy "default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'none'; img-src 'self' data: blob: https:; media-src 'self' blob:; font-src 'self' data:; style-src 'self' 'unsafe-inline'; script-src 'self' 'unsafe-inline' 'unsafe-eval'; connect-src 'self' https: wss:"
		-Server
	}

	# Block API schema/docs even when SWAGGER_ENABLED is accidentally left on.
	@blocked path /docs* /api/docs*
	handle @blocked {
		respond 404
	}

	# Socket.IO handshake/upgrade plus the /realtime namespace alias.
	@socket path /socket.io/* /realtime/*
	handle @socket {
		reverse_proxy api:3001 {
			transport http {
				read_timeout 1h
				write_timeout 1h
			}
		}
	}

	@api path /api/*
	handle @api {
		reverse_proxy api:3001 {
			health_uri /api/health
			health_interval 30s
			health_timeout 5s
		}
	}

	handle {
		reverse_proxy web:3000 {
			health_uri /
			health_interval 30s
			health_timeout 5s
		}
	}
}

# Apex redirect. Requires a DNS record for www and must be removed or edited
# if DOMAIN itself already starts with "www.".
www.{$DOMAIN} {
	redir https://{$DOMAIN}{uri} permanent
}
